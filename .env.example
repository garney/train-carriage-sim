NODE_ENV=development
PORT=3000

# Local Docker stack. `garney-stack init` writes real keys into .env.
JWT_SECRET=replace-with-a-long-random-hex
POSTGRES_PASSWORD=garney-local
POSTGRES_DB=postgres
# Host ports for Docker (each app gets its own block via garney-stack init / ports)
POSTGRES_PORT=54322
KONG_HTTP_PORT=54321
INBUCKET_PORT=9000

SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=replace-me

ADMIN_USER_IDS=

GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
